<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories untouched (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route, hand it to the React Router
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/x-icon .ico
</IfModule>
